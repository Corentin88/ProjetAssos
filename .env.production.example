# Nom DNS seul, sans schéma ni chemin.
PUBLIC_DOMAIN=projetassos.example.org
ACME_EMAIL=contact@example.org

# Générer trois valeurs indépendantes avec openssl rand -hex 32.
# Le mot de passe applicatif entre dans une URL. Utiliser les caractères hexadécimaux générés.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTH_JWT_SECRET=

# Réseau privé de Caddy vers NestJS, à adapter uniquement en cas de chevauchement.
# EDGE_IP doit appartenir au sous-réseau mais rester hors de EDGE_IP_RANGE.
EDGE_SUBNET=172.30.72.0/24
EDGE_IP_RANGE=172.30.72.128/25
EDGE_IP=172.30.72.2

# SMTP requis pour envoyer l'invitation du premier administrateur.
SMTP_URL=
MAIL_FROM=

# Optionnel. Redirection Google : https://PUBLIC_DOMAIN/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
