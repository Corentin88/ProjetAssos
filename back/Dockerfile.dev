FROM node:22.23.3-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY . .
RUN ./node_modules/.bin/prisma generate --config prisma7.config.ts

EXPOSE 3000
# Le CLI doit arrêter Node directement pour libérer le port avant chaque redémarrage.
CMD ["npm", "run", "start:dev", "--", "--no-shell", "--path", "tsconfig.docker.json"]
