FROM node:22.23.3-bookworm-slim AS base

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS dependencies
COPY package.json package-lock.json ./
RUN npm ci --include=dev

FROM dependencies AS migrate
ENV NODE_ENV=production
COPY prisma ./prisma
COPY prisma7.config.ts ./
USER node
CMD ["./node_modules/.bin/prisma", "migrate", "deploy", "--config", "prisma7.config.ts"]

FROM dependencies AS build
COPY . .
RUN ./node_modules/.bin/prisma generate --config prisma7.config.ts \
    && ./node_modules/.bin/nest build

FROM base AS runtime
ENV NODE_ENV=production PORT=3000
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
    && npm cache clean --force \
    && install -d -m 0750 -o node -g node /app/storage
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "dist/src/main.js"]
