POSTGRES_DB=DbAssos
POSTGRES_USER=UserAssos
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql://UserAssos:CHANGE_ME@127.0.0.1:5433/DbAssos?schema=public

# Générer une valeur aléatoire privée d’au moins 32 octets.
AUTH_JWT_SECRET=
# Utiliser le même site pour le front et l’API, HTTPS en production.
FRONT_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:3000/api/v1

# URL SMTP (smtps:// ou smtp:// avec STARTTLS) et adresse d’expédition.
SMTP_URL=
MAIL_FROM=

# URI Google à autoriser : API_ORIGIN + /api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Premier administrateur, via npm run bootstrap:admin dans back/ après compilation.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
